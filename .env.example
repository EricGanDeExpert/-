# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the transcription route, Whop webhook and cleanup cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# --- Whop (billing) ---
# Company API key (Dashboard -> Developer -> API keys)
WHOP_API_KEY=...
# Webhook signing secret, exactly as Whop shows it (ws_...)
WHOP_WEBHOOK_SECRET=ws_...
# Recurring monthly plan for Pro (US$5/month)
WHOP_PLAN_ID_PRO=plan_...

# --- Limits / privacy ---
FREE_PAGES_PER_MONTH=20
DEFAULT_RETENTION_DAYS=30

# --- Cron (Vercel sends "Authorization: Bearer $CRON_SECRET") ---
CRON_SECRET=generate-a-long-random-string
